# 复制成 backend/.env.local（该文件已被 .gitignore 挡住），密码不要提交。
# start-dev.ps1 会在启动时读取本文件并注入成环境变量。

SPRING_DATASOURCE_USERNAME=yu_app
# ↓ 把这行的等号后面填成 yu_app 的真实密码（纯 ASCII，不要带中文、空格、引号）
SPRING_DATASOURCE_PASSWORD=

# 需要改连接串时取消注释（默认指向本地隧道 127.0.0.1:13306）
# SPRING_DATASOURCE_URL=jdbc:mysql://127.0.0.1:13306/yu_picture?sslMode=VERIFY_CA&serverTimezone=Asia/Shanghai&characterEncoding=utf8&trustCertificateKeyStoreUrl=file:./.certs/ApsaraDB-CA-Chain.jks&trustCertificateKeyStorePassword=apsaradb&trustCertificateKeyStoreType=JKS

# 要验证迁移通道时临时打开（会真的连库并建 flyway_schema_history）
# SPRING_FLYWAY_ENABLED=true
